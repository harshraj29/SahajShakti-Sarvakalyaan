# Cloudinary > Dashboard > Product Environment Credentials
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Cloudinary > Settings > Upload > Upload presets
# Create an unsigned preset restricted to the "sahajshakti" folder.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# Server-only credentials, used to read the folder back and save captions.
# Never expose these to the browser and never commit them.
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional. Folder the public gallery reads from. Defaults to "sahajshakti".
CLOUDINARY_GALLERY_FOLDER=sahajshakti

# Password for /admin/media. Leave unset to lock the page entirely.
ADMIN_PASSWORD=choose-a-strong-password

# Contact form delivery. Get a free access key at https://web3forms.com
# (enter sahajshakti7@gmail.com, the key arrives by email). Messages are then
# delivered to that inbox. Leave unset and the form reports it is not connected.
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key
# Optional override if you switch providers.
# CONTACT_FORM_ENDPOINT=https://api.web3forms.com/submit
